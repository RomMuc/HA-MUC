#Solar Anlage
sensor:
  - platform: rest
    name: QCells Cloud
    resource: !secret qcells_cloud
    method: GET
    scan_interval: 10000000 #Will be fired every 5 minutes via automation
    timeout: 90
    value_template: >
          {% if value is defined and value_json is defined and 'current_status' in value_json %}
            {{ value_json.current_status }}
          {% else %}
            {{ this.state }}
          {% endif %}
#    value_template: 'OK'
    json_attributes_path: "$.result"
    json_attributes:
      - sn
      - acpower
      - yieldtoday
      - yieldtotal
      - feedinpower
      - feedinenergy
      - consumeenergy
      - feedinpowerM2
      - soc
      - peps1
      - peps2
      - peps3
      - inverterType
      - inverterStatus
      - uploadTime
      - batPower
      - powerdc1
      - powerdc2
      - powerdc3
      - powerdc4
      - batStatus

# Modern Template Key for all Template Sensors
template:
  - sensor:
      - name: "Unique identifier of communication module"
        unique_id: qcells_cloud_sn
        state: "{{ state_attr('sensor.qcells_cloud', 'sn') }}"

      - name: "Inverter AC power total"
        unique_id: qcells_cloud_acpower
        state: "{{ state_attr('sensor.qcells_cloud', 'acpower') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Solar energy generated - daily"
        unique_id: qcells_cloud_yieldtoday
        state: "{{ state_attr('sensor.qcells_cloud', 'yieldtoday') }}"
        unit_of_measurement: "kWh"
        device_class: energy
#        state_class: total_increasing

      - name: "Solar energy generated - total"
        unique_id: qcells_cloud_yieldtotal
        state: "{{ state_attr('sensor.qcells_cloud', 'yieldtotal') }}"
        unit_of_measurement: "kWh"
        device_class: energy
#        state_class: total_increasing

      - name: "Current grid power"
        unique_id: qcells_cloud_feedinpower
        state: "{{ state_attr('sensor.qcells_cloud', 'feedinpower') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Solar energy to Grid - total"
        unique_id: qcells_cloud_feedinenergy
        state: "{{ state_attr('sensor.qcells_cloud', 'feedinenergy') }}"
        unit_of_measurement: "kWh"
        device_class: energy
#        state_class: total_increasing

      - name: "Energy from Grid - total "
        unique_id: qcells_cloud_consumerenergy
        state: "{{ state_attr('sensor.qcells_cloud', 'consumeenergy') }}"
        unit_of_measurement: "kWh"
#        device_class: energy
#        state_class: total_increasing

      - name: "Inverter Meter2 AC power total"
        unique_id: qcells_cloud_feedinpowerm2
        state: "{{ state_attr('sensor.qcells_cloud', 'feedinpowerM2') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Inverter DC Battery power total"
        unique_id: qcells_cloud_batpower
        state: "{{ state_attr('sensor.qcells_cloud', 'batPower') }}"
        unit_of_measurement: "W"
        device_class: power

      - name: "Battery Charge"
        unique_id: qcells_cloud_battery_charge
        state: >
          {% if states('sensor.qcells_cloud_batpower') | float(default=0) > 0 %}
            {{ states('sensor.qcells_cloud_batpower') | float(default=0) }}
          {% else %}
            0
          {% endif %}
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Battery Discharge"
        unique_id: qcells_cloud_battery_discharge
        state: >
          {% if states('sensor.qcells_cloud_batpower') | float(default=0) < 0 %}
            {{ states('sensor.qcells_cloud_batpower') | float(default=0) | abs }}
          {% else %}
            0
          {% endif %}
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Battery level"
        unique_id: qcells_cloud_soc
        device_class: battery
        state: "{{ state_attr('sensor.qcells_cloud', 'soc') }}"
        unit_of_measurement: "%"

      - name: "Inverter AC EPS power 1"
        unique_id: qcells_cloud_peps1
        state: "{{ state_attr('sensor.qcells_cloud', 'peps1') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Inverter AC EPS power 2"
        unique_id: qcells_cloud_peps2
        state: "{{ state_attr('sensor.qcells_cloud', 'peps2') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Inverter AC EPS power 3"
        unique_id: qcells_cloud_peps3
        state: "{{ state_attr('sensor.qcells_cloud', 'peps3') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Inverter Type"
        unique_id: qcells_cloud_invertertype
        state: >-
          {% if state_attr('sensor.qcells_cloud', 'inverterType') == "1" %}
            X1-LX
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "2" %}
            X-Hybrid
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "3" %}
            X1-Hybiyd/Fit
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "4" %}
            X1-Boost/Air/Mini
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "5" %}
            X3-Hybiyd/Fit
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "6" %}
            X3-20K/30K
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "7" %}
            X3-MIC/PRO
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "8" %}
            X1-Smart
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "9" %}
            X1-AC
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "10" %}
            A1-Hybrid
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "11" %}
            A1-Fit
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "12" %}
            A1-Grid
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "13" %}
            J1-ESS
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "14" %}
            X3-Hybrid-G4
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "15" %}
            X1-Hybrid-G4
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "16" %}
            X3-MIC/PRO-G2
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "17" %}
            X1-SPT
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "18" %}
            X1-Boost/Mini-G4
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "19" %}
            A1-HYB-G2
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "20" %}
            A1-AC-G2
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "21" %}
            A1-SMT-G2
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "22" %}
            X3-FTH
          {% elif state_attr('sensor.qcells_cloud', 'inverterType') == "23" %}
            X3-MGA-G2
          {% else %}
            Unknown
          {% endif %}

      - name: "Inverter status"
        unique_id: qcells_cloud_inverterstatus
        state: >-
          {% if state_attr('sensor.qcells_cloud', 'inverterStatus') == "100" %}
            Wait Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "101" %}
            Check Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "102" %}
            Normal Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "103" %}
            Fault Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "104" %}
            Permanent Fault Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "105" %}
            Update Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "106" %}
            EPS Check Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "107" %}
            EPS Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "108" %}
            Self-Test Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "109" %}
            Idle Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "110" %}
            Standby Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "111" %}
            Pv Wake Up Bat Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "112" %}
            Gen Check Mode
          {% elif state_attr('sensor.qcells_cloud', 'inverterStatus') == "113" %}
            Gen Run Mode
          {% else %}
            Unknown status
          {% endif %}

      - name: "Update time"
        unique_id: qcells_cloud_uploadtime
        state: "{{ as_timestamp(state_attr('sensor.qcells_cloud', 'uploadTime')) | timestamp_local(default=0) }}"
        device_class: timestamp

      - name: "Inverter DC PV power MPPT1"
        unique_id: qcells_cloud_powerdc1
        state: "{{ state_attr('sensor.qcells_cloud', 'powerdc1') }}"
        device_class: power
#        state_class: measurement
        unit_of_measurement: "W"

      - name: "Inverter DC PV power MPPT2"
        unique_id: qcells_cloud_powerdc2
        state: "{{ state_attr('sensor.qcells_cloud', 'powerdc2') }}"
        unit_of_measurement: "W"
#        state_class: measurement
        device_class: power

      - name: "Inverter DC PV power MPPT3"
        unique_id: qcells_cloud_powerdc3
        state: "{{ state_attr('sensor.qcells_cloud', 'powerdc3') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Inverter DC PV power MPPT4"
        unique_id: qcells_cloud_powerdc4
        state: "{{ state_attr('sensor.qcells_cloud', 'powerdc4') }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "Battery Status"
        unique_id: qcells_cloud_batstatus
        state: >-
          {% if state_attr('sensor.qcells_cloud', 'batStatus') == "0" %}
            Self Use Mode
          {% elif state_attr('sensor.qcells_cloud', 'batStatus') == "1" %}
            Force Time Use
          {% elif state_attr('sensor.qcells_cloud', 'batStatus') == "2" %}
            Back Up Mode
          {% elif state_attr('sensor.qcells_cloud', 'batStatus') == "3" %}
            Feed-in Priority
          {% else %}
            Unknown status
          {% endif %}

      - name: "Inverter DC PV Power Total"
        unique_id: qcells_powerdc_sum
        state: "{{ states('sensor.qcells_cloud_powerdc1') | float(default=0) + states('sensor.qcells_cloud_powerdc2') | float(default=0) + states('sensor.qcells_cloud_powerdc3') | float(default=0) + states('sensor.qcells_cloud_powerdc4') | float(default=0) }}"
        unit_of_measurement: "W"
        device_class: power
#        state_class: measurement

      - name: "House Load"
        unique_id: qcells_cloud_house_load
        state: "{{ states('sensor.qcells_cloud_feedinpowerm2') | float(default=0) + states('sensor.qcells_cloud_acpower') | float(default=0) - states('sensor.qcells_cloud_feedinpower') | float(default=0) }}"
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Solar Grid Feed"
        unique_id: qcells_cloud_grid_feed
        state: >
          {% if states('sensor.qcells_cloud_feedinpower') | float(default=0) > 0 %}
            {{ states('sensor.qcells_cloud_feedinpower') | float(default=0) }}
          {% else %}
            0
          {% endif %}
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "SWM Load"
        unique_id: qcells_cloud_grid_load
        state: >
          {% if states('sensor.qcells_cloud_feedinpower') | float(default=0) < 0 %}
            {{ states('sensor.qcells_cloud_feedinpower') | float(default=0) | abs }}
          {% else %}
            0
          {% endif %}
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Battery usable"
        unique_id: qcells_cloud_battery_usable
        state: "{{ 5500 * 0.9 * ([states('sensor.qcells_cloud_soc') | float(default=0) - 10, 0] | max / 100) }}"
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Solar plus Battery total"
        unique_id: qcells_cloud_solar_plus_battery_total
        state: "{{ states('sensor.qcells_cloud_powerdc_sum') | float(default=0) + states('sensor.qcells_cloud_battery_usable') | float(default=0) }}"
        unit_of_measurement: W
        device_class: power
#        state_class: measurement

      - name: "Electricity Consumer Tariff Price"
        unique_id: electricity_consumer_tariff_price
        unit_of_measurement: EUR/kWh
        state: >
          {% if is_state('utility_meter.electricity_daily_energy', 'Standard') %}
              {{ 0.3757 }}
          {% elif is_state('utility_meter.electricity_daily_energy', 'Standard') %}
              {{ 0.3757 }}
          {% else %}
              {{ 0.3757 }}
          {% endif %}

      - name: "Electricity Feed-in Tariff Price"
        unique_id: electricity_feedin_tariff_price
        unit_of_measurement: EUR/kWh
        state: 0.082


#Energy costs utility meter
utility_meter:
  electricity_daily_energy: #legacy
    source: sensor.qcells_cloud_consumeenergy #Pulled from SWM
    name: Electricity Consumed Daily (SWM)
    cycle: daily
    tariffs:
      - Standard
#      - Peak
#      - Offpeak
#  solax_electricity_daily_energy: #solax integration
#    source: sensor.keller_solax_swm_load
#    name: Solax Electricity Consumed Daily (SWM)
#    cycle: daily
#    tariffs:
#      - Standard

#Automatically switch the tariffs
automation:
  alias: Switch Peak/Offpeak Electricity Tariffs
  trigger:
    - platform: time
      at: "06:00:00"
      variables:
        tariff: "Standard"
    - platform: time
      at: "21:00:00"
      variables:
        tariff: "Standard"
  action:
    - service: select.select_option
      target:
        entity_id: select.electricity_daily_energy
      data:
        option: "{{ tariff }}"


